# Localhost-first mode (docs/architecture/deployment-strategy.md, Addendum 2026-08-11).
# cp .env.example .env in the repo root, fill ANTHROPIC_API_KEY, then `docker compose up`.
# docker-compose.yml passes this whole file into the asr container via env_file — nothing
# else to configure. Never commit the real .env (see .gitignore).

# --- ASR ---
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_DEVICE=cpu
WHISPER_CPU_THREADS=2
MAX_CONCURRENT_ASR=2

# Guide 1 wants <1.2s interim but guide 6 only fires at 2.0s. Lower WINDOW_SEC to close
# the gap; CPU cost scales roughly inversely. On HF free (2 vCPU) 1.0 is about the floor
# for a single session.
WINDOW_SEC=2.0
OVERLAP_SEC=0.5

ENERGY_GATE_DB=-45.0
VAD_THRESHOLD=0.5

# --- Auth ---
# Non-empty by default so /stream and /suggest actually enforce the session token end to
# end (see auth.py: an empty secret makes verify() accept every token). This value never
# leaves your machine — the real security boundary is the 127.0.0.1 port binding in
# docker-compose.yml, not this secret. Change it only if you want tokens minted on this
# laptop to be unguessable by another local account on the same machine.
AUTH_SECRET=localhost-dev-secret-change-me
# False is the safe default now that AUTH_SECRET above is non-empty: if AUTH_SECRET is ever
# emptied by mistake, the server refuses to start instead of silently running with auth
# disabled (config.py). Only set true if you deliberately want to run with no AUTH_SECRET.
ALLOW_INSECURE_NO_AUTH=false
TOKEN_TTL_SEC=120

# GET /dev/token mints a session token with no login check - a stand-in for the Laravel
# issuer that doesn't exist yet (services/auth-laravel/ is still a placeholder). Safe here
# only because the port is bound to 127.0.0.1 (docker-compose.yml) - never flip this true
# on any deployment reachable from outside this machine.
ALLOW_DEV_TOKEN=true

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_SEC=15

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:5500
