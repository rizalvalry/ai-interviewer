# Copy to services/asr-suggest/.env and load it, or set these in the HF Space "Variables and secrets" panel.

# --- ASR ---
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_CPU_THREADS=2
MAX_CONCURRENT_ASR=2

# Guide 1 wants <1.2s interim but guide 6 only fires at 2.0s. Lower WINDOW_SEC to close
# the gap; CPU cost scales roughly inversely. On HF free (2 vCPU) 1.0 is about the floor
# for a single session.
WINDOW_SEC=2.0
OVERLAP_SEC=0.5

ENERGY_GATE_DB=-45.0
VAD_THRESHOLD=0.5

# --- Auth ---
# Empty = disabled. Localhost only. A public HF Space without this is an open CPU faucet.
# In production Laravel signs tokens with this exact secret.
AUTH_SECRET=
# The server refuses to start if AUTH_SECRET is empty unless this is explicitly true - it
# must stay unset/false on any public deployment (HF Space). Setting it true there would
# accept every /stream and /suggest call with no token. Set to true only in your own local
# .env to keep running without AUTH_SECRET for local dev exactly as before.
ALLOW_INSECURE_NO_AUTH=true
TOKEN_TTL_SEC=120

# GET /dev/token mints a session token with no login check - a stand-in for the Laravel
# issuer that doesn't exist yet. Must stay unset/false on any public deployment (HF Space)
# until Laravel replaces it, even if AUTH_SECRET is set - otherwise anyone who finds the
# URL can self-mint a token and consume ASR/Claude compute for free. Set to true only in
# your own local .env to keep using /dev/token for local dev exactly as before.
ALLOW_DEV_TOKEN=false

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_SEC=15

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
