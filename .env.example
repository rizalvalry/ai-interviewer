# Localhost-first mode (docs/architecture/deployment-strategy.md, Addendum 2026-08-11).
# cp .env.example .env in the repo root, fill GEMINI_API_KEY, then `docker compose up`.
# docker-compose.yml passes this whole file into the asr container via env_file — nothing
# else to configure. Never commit the real .env (see .gitignore).

# --- ASR ---
# small is the default since the 2026-08-11 ASR bugfix (base mis-heard short/ambiguous
# Indonesian utterances). Uses more CPU/RAM per inference - drop to `base` if a laptop
# struggles to keep up in real time (see README "Model Whisper" section for the tradeoff).
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_DEVICE=cpu
# bug-hunter H4 (2026-08-11): 2 was tuned for a 2-vCPU cloud instance, not a real laptop -
# measured 2.15x real-time (falling behind) on a 32-core box. 8 measured best; going higher
# (tested 16) was WORSE due to thread-scaling overhead in this backend. Even at 8, sustained
# fast/continuous speech on both channels at once can still fall behind - watch the
# "audio_dropped_sec" footer metric / warning banner in the UI, which now surfaces this
# instead of silently discarding audio.
WHISPER_CPU_THREADS=8
MAX_CONCURRENT_ASR=2

# Guide 1 wants <1.2s interim but guide 6 only fires at 2.0s. Lower WINDOW_SEC to close
# the gap; CPU cost scales roughly inversely. On HF free (2 vCPU) 1.0 is about the floor
# for a single session.
WINDOW_SEC=2.0
OVERLAP_SEC=0.5

ENERGY_GATE_DB=-45.0
VAD_THRESHOLD=0.5
# Segments with avg_logprob below this are dropped entirely (not shown low-conf, not shown
# at all) - see docs/instructions-bugfix-asr-indonesian.md. -0.85 catches catastrophic decode
# failures without also dropping legitimately-hard-but-correct short utterances (avg_logprob
# alone can't cleanly separate those two at a tighter threshold - see config.py comment).
LOW_CONF_LOGPROB=-0.85

# --- Auth ---
# Non-empty by default so /stream and /suggest actually enforce the session token end to
# end (see auth.py: an empty secret makes verify() accept every token). This value never
# leaves your machine — the real security boundary is the 127.0.0.1 port binding in
# docker-compose.yml, not this secret. Change it only if you want tokens minted on this
# laptop to be unguessable by another local account on the same machine.
AUTH_SECRET=localhost-dev-secret-change-me
# False is the safe default now that AUTH_SECRET above is non-empty: if AUTH_SECRET is ever
# emptied by mistake, the server refuses to start instead of silently running with auth
# disabled (config.py). Only set true if you deliberately want to run with no AUTH_SECRET.
ALLOW_INSECURE_NO_AUTH=false
# Token TTL: interview session bisa berlangsung >30 menit; 120s terlalu pendek
# (WS reconnect dengan token expired -> 4401 -> channel mati selamanya).
# 7200 = 2 jam, cukup untuk sesi interview terpanjang di localhost.
TOKEN_TTL_SEC=7200

# GET /dev/token mints a session token with no login check - a stand-in for the Laravel
# issuer that doesn't exist yet (services/auth-laravel/ is still a placeholder). Safe here
# only because the port is bound to 127.0.0.1 (docker-compose.yml) - never flip this true
# on any deployment reachable from outside this machine.
ALLOW_DEV_TOKEN=true

# --- Gemini (provider utama, ADR Addendum 2026-08-11 (2) — free tier, REST via httpx) ---
# Wajib diisi manual dari aistudio.google.com/apikey. Kosong = /suggest & terjemahan
# nonaktif graceful (transkrip tetap jalan); tidak pernah dikirim ke frontend/browser.
GEMINI_API_KEY=
GEMINI_SUGGEST_MODEL=gemini-3.5-flash
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEC=15

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:5500

# --- Riwayat portfolio (ADR Addendum 2026-08-11 (3)) ---
# Default sudah cocok dengan named volume portfolio-data di docker-compose.yml - biarkan
# kosong kecuali kamu tahu kamu mengubah mount path volume itu juga.
PORTFOLIO_DB_PATH=/home/user/data/portfolios.db
